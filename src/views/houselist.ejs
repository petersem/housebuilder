<!DOCTYPE html>
<html lang="en">

<head>
    <title>
        <%= title %>
    </title>
    <%- include("partials/head.ejs") %>
        <!-- <script src="/scripts/houselist.mjs" type="module"></script> -->
        <script type="module">
            import { ClientHouseListController } from "/scripts/controllers/ClientHouseListController.mjs";
            window.addEventListener("DOMContentLoaded", () => {
                ClientHouseListController.renderHouses();
        });
        </script>
</head>

<body>
    <main>
        <%- include("partials/menu.ejs") %>
            <section>
                <h2>House list</h2>
                <span id="pageTitle">
                    &nbsp;&nbsp;<i class="fa-duotone fa-light fa-user-helmet-safety"></i>&nbsp;&nbsp;<%= title %>
                </span>
                <div id="top-controls"></div>
                <div id="search-sort-row">
                    <label for="searchBox"></label><input id="searchBox" placeholder="Search title..." value=""
                        onkeyup="search()">

                    <select id="sort" onchange="sort()" data-id="">
                    <option value=" unsorted">
                        No sort
                        </option>
                    </select>
                    <a id="newBtn" href="/housebuilder/create">New</a>
                </div>

                <section id="house-list">
                <h2>House list</h2>

                </section>
            </section>
            <footer>
                <span>© 2026 Uptown I.T. All rights reserved.</span> <span>Version: <%= ver %></span>
            </footer>
    </main>
</body>

</html>