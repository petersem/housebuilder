<!DOCTYPE html>
<html lang="en">

<head>
    <title>
        <%= title %>
    </title>
    <%- include("partials/head.ejs") %>
    <!-- TODO this probably needs to move to a NEW controller -->
        <!-- <script src="/scripts/houseedit.mjs" type="module"></script> -->

        <script type="module">
            import { ClientHouseBuilderController } from "/scripts/controllers/ClientHouseBuilderController.mjs";
            window.addEventListener("DOMContentLoaded", () => {
                ClientHouseBuilderController.renderEdit();
            });
        </script>
</head>

<body>
    <main>
        <%- include("partials/menu.ejs") %>
            <section>
                <h2>House details</h2>
                <span id="pageTitle">
                    &nbsp;&nbsp;<i class="fa-duotone fa-solid fa-hammer"></i>&nbsp;&nbsp;<%= title %>
                </span>

                <section>
                    <h2>House details</h2>
                    <form>
                        <span class="money" id="totalCost">$0</span>

                        <label for="title">Title</label>
                        <input id="title" name="title" required pattern="^(?!.*  )[A-Za-z0-9 .,'&\-]{3,30}$" type="text"
                            value="">
                        <span class="error">Must be 3 to 30 characters in length, with no double spaces</span>

                        <label for="companyName">Company</label>
                        <select id="companyName" name="companyName" required>
                            <option value="" disabled selected>Select a company…</option>
                            <option value="a">a</option>
                            <option value="b">b</option>
                            <option value="c">c</option>
                        </select>
                        <span class="error">Please select a company</span>

                        <label for="rooms">Rooms</label>
                        <input id="rooms" name="rooms" type="text" required pattern="^(?:[1-9]|1[0-5])$">
                        <span class="error">Rooms must be a whole number from 1 to 15</span>

                        <label for="bathrooms">Bathrooms</label>
                        <input id="bathrooms" name="bathrooms" type="text" required pattern="^[12]$">
                        <span class="error">Bathrooms must be 1 or 2</span>

                        <label for="garages">Garages</label>
                        <input id="garages" name="garages" type="text" required pattern="^[12]$">
                        <span class="error">Garages must be 1 or 2</span>

                        <label for="floorAreaSqm">Floor area sqm</label>
                        <input id="floorAreaSqm" name="floorAreaSqm" type="text" required
                            pattern="^(?:[1-7][0-9]{2}|800)$">
                        <span class="error">Floor area must be 100–800 sqm</span>

                        <label for="storyCount">Stories</label>
                        <input id="storyCount" name="storyCount" type="text" required pattern="^[12]$">
                        <span class="error">Stories must be 1 or 2</span>

                        <label>Extras</label>
                        <div class="checkbox-row" id="checkbox-row">
                            <!-- This is dynamically built
                            <div>
                                <input id="builtIns" name="builtIns" type="checkbox" value="Built-ins"> <label for="builtIns">Built in wardrobes</label>
                            </div> -->
                        </div>


                        <button id="saveBtn" type="button" onclick="updateHouse()">Save</button>
                        <button id="cancelBtn" type="button" onclick="history.back();">Cancel</button>
                    </form>

                </section>
            </section>

            <footer>
                <span>© 2026 Uptown I.T. All rights reserved.</span> <span>Version: <%= ver %></span>
            </footer>
    </main>
</body>

</html>